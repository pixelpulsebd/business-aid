# Existing Business Aid main-site enquiry form (Google Sheets API)
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_spreadsheet_id
GOOGLE_SHEETS_RANGE=Enquiries!A:F

# Client Brief form (Google Apps Script webhook)
# These must be configured as server-side variables in Vercel.
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
SHEET_TOKEN=replace_with_a_long_random_secret
