# Shared Google Sheets destination for Business Aid enquiries and The Shadow questionnaire.
# Both forms write to tabs in this same spreadsheet file: Enquiries and the-shadow.
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project-id.iam.gserviceaccount.com
